{
  "name": "agentium-mcp",
  "version": "0.1.1",
  "description": "Agentium MCP Server — local-first Chrome browser automation bridge for AI assistants over Model Context Protocol",
  "type": "module",
  "license": "MIT",
  "author": "abhilov23",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhilov23/agentium.git"
  },
  "homepage": "https://github.com/abhilov23/agentium#readme",
  "bugs": {
    "url": "https://github.com/abhilov23/agentium/issues"
  },
  "bin": {
    "agentium-mcp": "./dist/index.js",
    "agentium": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome",
    "automation",
    "browser",
    "ai-agent",
    "claude",
    "cursor",
    "devtools"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "tsc",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
