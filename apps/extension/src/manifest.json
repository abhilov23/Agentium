{
  "manifest_version": 3,
  "name": "Agentium Browser Extension",
  "version": "0.1.0",
  "description": "Browser-side adapter, It allows to Inspect and interact with pages you explicitly authorize.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/agentium-16.png",
    "32": "icons/agentium-32.png",
    "48": "icons/agentium-48.png",
    "128": "icons/agentium-128.png"
  },
  "action": {
    "default_title": "Agentium",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/agentium-16.png",
      "32": "icons/agentium-32.png",
      "48": "icons/agentium-48.png",
      "128": "icons/agentium-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker/index.js",
    "type": "module"
  },
  
  "permissions": ["tabs", "scripting", "alarms", "storage" , "webNavigation", "notifications", "downloads", "cookies", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
